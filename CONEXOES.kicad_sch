			)
			(justify left)
		)
		(uuid "e11f920b-b7ec-4594-ae2a-fbdb7e39736b")
	)
	(text "3. J3 FT232RL USB-C module: 1 GND, 2 CTS (NC), 3 +5V, 4 TXO -> D0 / RXD, 5 RXI <- D1 / TXD, 6 DTR -> C7 100 nF -> RESET."
		(exclude_from_sim no)
		(at 45.466 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
			(justify left)
		)
		(uuid "e53eb010-233e-4805-b258-171eff8fd5c6")
	)
	(text "2. A4 / A5 are repeated on SDA / SCL (UNO R3 layout). IOREF is tied to +5V; the unlabelled pin P1 is not connected."
		(exclude_from_sim no)
		(at 45.466 147.066 0)
