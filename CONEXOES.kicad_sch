	)
	(text "1. A1 Arduino UNO R3 female headers (2.54 mm): power 8, analog 6, digital 8 + 10. Shield compatible."
		(exclude_from_sim no)
		(at 45.466 144.272 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
