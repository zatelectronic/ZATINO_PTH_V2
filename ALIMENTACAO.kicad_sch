	(text "1. J2 7-12 V -> D1 1N4007 (reverse polarity) -> VIN -> U2 AMS1117-5.0 -> +5V -> U3 AMS1117-3.3 -> +3.3V."
		(exclude_from_sim no)
		(at 55.626 136.652 0)
		(effects
